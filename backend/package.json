{
  "name": "terrascope-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de TerraScope (Node + Express + MySQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "db:setup": "node scripts/setup-db.js",
    "db:verify": "node scripts/verify-spatial.js",
    "db:import-somerton": "node scripts/import-somerton-official-data.js",
    "db:seed-demo": "node scripts/seed-demo.js",
    "e2e": "node scripts/e2e-smoke.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  }
}
