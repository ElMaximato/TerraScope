# Copia este archivo como .env y completa los valores. NUNCA subas .env a un repositorio.

PORT=3000

# Base de datos MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=terrascope
# Base solo para pruebas de integración (se borran sus datos)
DB_NAME_TEST=terrascope_test

# Sesión (JWT): mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Clave gratuita del Census (https://api.census.gov/data/key_signup.html): solo para importar datos
CENSUS_API_KEY=

# --- Opcionales ---
# IA para los resúmenes (Google AI Studio, nivel gratuito). Sin clave, la app usa solo el reporte de plantilla.
GEMINI_API_KEY=
# GEMINI_MODEL=            # nombre exacto del modelo que muestre AI Studio
# GEMINI_FALLBACK_MODEL=   # modelo de respaldo si el principal está saturado
# AI_RATE_LIMIT_MAX=10     # llamadas con IA por usuario cada 10 minutos

# Habilitar CORS solo si usas una página web de pruebas (la app móvil no lo necesita)
# CORS_ORIGIN=http://localhost:5173

# Dominios de correo extra permitidos al registrarse (separados por coma)
# EXTRA_EMAIL_DOMAINS=

# Datos de demostración (npm run db:seed-demo)
# DEMO_EMAIL=demo@terrascope.local
# DEMO_PASSWORD=Demo-TerraScope-2026
